# Файл с секретами. НЕ выкладывай его в интернет и не присылай в чат.
# Скопируй этот файл в .env и впиши свои значения.

# Токен бота от @BotFather
BOT_TOKEN=

# Ключ DeepSeek (platform.deepseek.com -> API keys)
DEEPSEEK_API_KEY=

# Код-приглашение для входа в бота (обязательно поменяй!)
INVITE_CODE=

# Модели. Менять не нужно, если нет особой причины.
DEEPSEEK_TEXT_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-flash
